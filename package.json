{
  "name": "pos-backend",
  "version": "1.0.0",
  "description": "POS system REST API (Express + MySQL)",
  "main": "server.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate": "node scripts/migrate.js",
    "migrate:status": "node scripts/migrate.js --status",
    "db:verify": "node scripts/verify-schema.js",
    "db:backup": "node scripts/backup-database.js",
    "db:up": "docker compose -f compose.database.yaml up -d --wait",
    "db:down": "docker compose -f compose.database.yaml down",
    "test:db": "node --test tests/integration/schema.test.cjs",
    "test:backend": "node --test tests/integration/backend.test.cjs",
    "test:counter": "node --test tests/integration/counter.test.cjs",
    "demo:setup": "node scripts/setup-demo.js",
    "counter:setup": "node scripts/setup-counter.js",
    "create-admin": "node scripts/create-admin.js",
    "seed:permissions": "node database/seeds/seed-permissions.js",
    "seed:admin": "node database/seeds/seed-admin.js",
    "check": "node scripts/check-env.js",
    "check:code": "node scripts/check-code.js",
    "test": "node --test tests/unit/*.test.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@vercel/blob": "^2.8.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "mysql2": "^3.23.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
