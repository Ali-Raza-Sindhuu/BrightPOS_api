# Local API + Docker MySQL. Copy to .env and replace the JWT/admin placeholders.
NODE_ENV=test
HOST=127.0.0.1
PORT=5000
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=brightpos
DB_PASSWORD=brightpos_local_only
DB_NAME=brightpos_migration_test
DB_CONNECTION_LIMIT=3
DB_QUEUE_LIMIT=30
DB_CONNECT_TIMEOUT_MS=10000
DB_SSL=false
JWT_SECRET=brightpos_test_secret_1234567890_abcdef
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
TRUST_PROXY=false
UPLOAD_DIR=uploads
UPLOAD_MAX_FILE_SIZE_MB=4
ADMIN_USERNAME=admin
ADMIN_FULL_NAME=Local Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
