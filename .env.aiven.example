# Local API + Docker MySQL. Copy to .env and replace the JWT/admin placeholders.
NODE_ENV=production
HOST=127.0.0.1
PORT=5000
DB_HOST=replace-with-your-service-host.aivencloud.com
DB_PORT=replace-with-service-port
DB_USER=avnadmin
DB_PASSWORD=replace-with-your-service-password
DB_NAME=defaultdb
DB_CONNECTION_LIMIT=3
DB_QUEUE_LIMIT=30
DB_CONNECT_TIMEOUT_MS=10000
DB_SSL=true
DB_SSL_CA_FILE=certs/aiven-ca.pem
# On Vercel use DB_SSL_CA=full-PEM-text instead of DB_SSL_CA_FILE.
JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
JWT_EXPIRES_IN=8h
CORS_ORIGIN=https://replace-with-your-pos.vercel.app
TRUST_PROXY=1
UPLOAD_DIR=uploads
UPLOAD_MAX_FILE_SIZE_MB=4
ADMIN_USERNAME=admin
ADMIN_FULL_NAME=Local Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
