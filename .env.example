# One backend configuration for Docker, API, migration and tests. Copy to .env.
NODE_ENV=development
HOST=127.0.0.1
PORT=5000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=BadyBear
DB_PASSWORD=replace-with-your-local-database-password
DB_ROOT_PASSWORD=replace-with-your-local-mysql-root-password
DB_NAME=brightposlocal
DEMO_DB_NAME=brightpos_demo
DB_CONNECTION_LIMIT=3
DB_QUEUE_LIMIT=30
DB_CONNECT_TIMEOUT_MS=10000
DB_SSL=false
JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
TRUST_PROXY=false
UPLOAD_DIR=uploads
UPLOAD_MAX_FILE_SIZE_MB=4
ADMIN_USERNAME=admin
ADMIN_FULL_NAME=Local Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=replace-with-a-password-at-least-12-characters
