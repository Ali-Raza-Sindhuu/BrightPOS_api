# ---------------------------------------------------------------------------
# POS Backend — environment configuration
#
# Copy this file to `.env` and fill in real values:
#     cp .env.example .env
#
# On cPanel you can either upload this .env file into the application root,
# or enter the same keys/values in "Setup Node.js App" → Environment Variables.
# A .env file is easier to keep in sync — the app reads it from the app root
# regardless of the working directory it was started from.
#
# NEVER commit the real .env — it is already listed in .gitignore.
# ---------------------------------------------------------------------------

# --- Runtime --------------------------------------------------------------
# `production` enables combined access logs and hides internal error details
# from API responses. Use `development` on your local machine.
NODE_ENV=development

# Port the API listens on. On cPanel this is assigned automatically by
# Passenger and this value is ignored — leave it as-is.
PORT=5000

# Interface to bind to. Leave as 0.0.0.0 unless you know you need otherwise.
HOST=0.0.0.0


# --- Database (cPanel → MySQL Databases) ----------------------------------
# On cPanel the database and user names are prefixed with your account name,
# e.g. account "afaqmis" creating db "pos" gives you `afaqmis_pos`.
# The DB almost always lives on the same server, so localhost is correct.
DB_HOST=localhost
DB_PORT=3306
DB_USER=brightpos
DB_PASSWORD=change-me-for-local-development
DB_NAME=brightpos

# Max simultaneous MySQL connections in the pool. Shared cPanel hosting often
# caps concurrent connections per user — lower this to 5 if you hit limits.
DB_CONNECTION_LIMIT=10


# --- Authentication -------------------------------------------------------
# A long random string used to sign JWTs. Generate a fresh one per deployment:
#     node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Changing this invalidates every issued token (all users must log in again).
JWT_SECRET=replace-with-a-long-random-string

# How long a login stays valid. Accepts zeit/ms syntax: 60m, 8h, 7d.
JWT_EXPIRES_IN=8h


# --- CORS -----------------------------------------------------------------
# Comma-separated list of frontend origins allowed to call this API.
# Scheme + host + port only — no trailing slash, no path.
# Leave empty for local development. Production browser origins are denied
# until you provide the exact comma-separated frontend origin list.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,https://your-pos.vercel.app,https://your-marketing.vercel.app


# --- Uploads --------------------------------------------------------------
# Where item images are written. Relative paths resolve from the backend root.
# Point this at a directory OUTSIDE the deploy folder if you redeploy by
# replacing the folder, so uploaded images survive a redeploy.
UPLOAD_DIR=uploads

# Per-file upload limit in megabytes.
UPLOAD_MAX_FILE_SIZE_MB=5


# --- Proxy ----------------------------------------------------------------
# Trust X-Forwarded-* headers so req.ip is the real client address rather than
# the proxy's. Must stay `true` on cPanel (Passenger sits in front of Node).
TRUST_PROXY=true
